<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BreadBoard</AssemblyName>
    <RootNamespace>BreadBoard.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.0</Version>
    <!-- Startup: precompile on publish, keep the dynamic PGO/tiering defaults. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BreadBoard.Core\BreadBoard.Core.csproj" />
    <ProjectReference Include="..\BreadBoard.Audio\BreadBoard.Audio.csproj" />
    <ProjectReference Include="..\BreadBoard.Platform\BreadBoard.Platform.csproj" />
  </ItemGroup>

</Project>
