<Window x:Class="BreadBoard.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:BreadBoard.App.Theme"
        Title="Bread Board"
        Icon="pack://application:,,,/Assets/BreadBoard.ico"
        MinWidth="820" MinHeight="600"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="72" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="16,24,16,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                        <Image x:Name="LogoSpot" Width="92" Height="92" Source="{StaticResource LogoImage}"
                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Bread Board logo"/>
                        <StackPanel x:Name="BrandText" Margin="0,12,0,0">
                            <TextBlock Text="Bread Board" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Soundboard" HorizontalAlignment="Center" Foreground="{StaticResource MuteBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="Nav" DockPanel.Dock="Top" Margin="0,28,0,0" KeyboardNavigation.TabNavigation="Once"
                                KeyboardNavigation.DirectionalNavigation="Cycle"/>

                    <StackPanel DockPanel.Dock="Bottom">
                        <ToggleButton x:Name="GamingButton" Height="44" Margin="0,0,0,10" Cursor="Hand" Foreground="{StaticResource InkBrush}"
                                      FocusVisualStyle="{StaticResource FocusRing}" ToolTip="Gaming Mode: open the floating mini-player">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="B" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="Transparent" Padding="14,0">
                                        <DockPanel>
                                            <TextBlock x:Name="I" Text="{x:Static t:Glyph.Game}" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="State" DockPanel.Dock="Right" Text="Off" FontSize="12" Foreground="{StaticResource MuteBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="L" Text="Gaming Mode" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{StaticResource RaisedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="B" Property="Background" Value="#1AE3C8A4"/>
                                            <Setter TargetName="I" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="L" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="State" Property="Text" Value="On"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="compact">
                                            <Setter TargetName="L" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="State" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="I" Property="Margin" Value="0"/>
                                            <Setter TargetName="B" Property="Padding" Value="0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border x:Name="VmCard" Style="{StaticResource FlatCard}" Padding="14,12" CornerRadius="14">
                            <DockPanel>
                                <CheckBox x:Name="VmSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          ToolTip="Virtual mic on/off (off sends silence)" AutomationProperties.Name="Virtual mic on"/>
                                <StackPanel x:Name="VmText" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="VmDot" Width="9" Height="9" Fill="{StaticResource MuteBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Virtual Mic" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock x:Name="VmStatus" Text="Not connected" Margin="17,1,0,0" FontSize="12" Foreground="{StaticResource MuteBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="Footer" Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource MuteBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Main area ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar: search (interactive) + caption buttons; the rest drags the window. -->
                <Grid Grid.Row="0" Margin="28,14,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="600"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="46" CornerRadius="23" Background="{StaticResource RaisedBrush}" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static t:Glyph.Search}" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource MuteBrush}"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search sounds…" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MuteBrush}" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource InkBrush}" CaretBrush="{StaticResource AccentBrush}" FontSize="15"
                                     VerticalContentAlignment="Center" AutomationProperties.Name="Search sounds"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-6,0,0">
                        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="{x:Static t:Glyph.Minimize}" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="{x:Static t:Glyph.Maximize}" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="{x:Static t:Glyph.Close}" ToolTip="Close" AutomationProperties.Name="Close"/>
                    </StackPanel>
                </Grid>

                <ContentControl Grid.Row="1" x:Name="PageHost" Focusable="False" Margin="28,6,28,0"/>

                <!-- Toast: short confirmations and errors, bottom-centre over the page. -->
                <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="40,0,40,16" MaxWidth="640"
                        CornerRadius="14" Padding="16,11" Background="{StaticResource RaisedBrush}" BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                        Visibility="Collapsed" Cursor="Hand" ToolTip="Click to dismiss">
                    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="580"/>
                    </StackPanel>
                </Border>

                <!-- Bottom audio section: levels per source + engine status. -->
                <Border Grid.Row="2" Style="{StaticResource FlatCard}" Margin="28,16,28,22" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{x:Static t:Glyph.Waveform}" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Accent2Brush}" Margin="0,0,12,0"/>
                            <StackPanel MaxWidth="230">
                                <TextBlock x:Name="EngineTitle" Text="Audio engine idle" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EngineDetail" Text="Starts when you add a sound or choose an app" FontSize="12" Foreground="{StaticResource MuteBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                        <UniformGrid Grid.Column="1" Rows="1" VerticalAlignment="Center">
                            <UniformGrid.Resources>
                                <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource MuteBrush}"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
                            </UniformGrid.Resources>
                            <StackPanel Margin="0,0,16,0" ToolTip="Microphone level"><TextBlock x:Name="MicMeterLabel" Text="Microphone" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="MicMeter" Style="{StaticResource Meter}" Maximum="1" Value="0"/></StackPanel>
                            <StackPanel x:Name="AppMeterBox" Margin="0,0,16,0" ToolTip="Choose an app on the Mixer page"><TextBlock x:Name="AppMeterLabel" Text="App audio" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="AppMeter" Style="{StaticResource Meter}" Maximum="1" Value="0"/></StackPanel>
                            <StackPanel Margin="0,0,16,0" ToolTip="Live level of the soundboard"><TextBlock Text="Soundboard"/><ProgressBar x:Name="BoardMeter" Style="{StaticResource Meter}" Maximum="1" Value="0"/></StackPanel>
                            <StackPanel Margin="0,0,16,0" ToolTip="Level sent to the virtual mic"><TextBlock x:Name="MasterMeterLabel" Text="Master" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="MasterMeter" Style="{StaticResource Meter}" Maximum="1" Value="0"/></StackPanel>
                        </UniformGrid>
                        <Border Grid.Column="2" CornerRadius="16" Background="{StaticResource RaisedBrush}" Padding="14,7" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource MuteBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="48 kHz · 32-bit float" FontSize="13" Foreground="{StaticResource InkBrush}" Opacity="0.8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
