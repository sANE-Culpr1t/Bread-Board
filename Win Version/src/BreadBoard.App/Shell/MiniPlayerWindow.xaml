<Window x:Class="BreadBoard.App.Shell.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:BreadBoard.App.Theme"
        Title="Bread Board — Mini Player"
        MinWidth="290" MinHeight="300"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Layered window so the opacity setting can let the game show through. -->
    <Border x:Name="Surface" Background="{StaticResource SidebarBrush}" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: drag to move -->
        <Border x:Name="Header" Grid.Row="0" Padding="14,10,8,10" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Cursor="SizeAll">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Width="30" Height="30" FontSize="13" Background="Transparent"
                                  Content="{x:Static t:Glyph.Pin}" ToolTip="Keep on top" AutomationProperties.Name="Keep on top" Cursor="Hand"/>
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Background="Transparent"
                            Content="&#xE70E;" ToolTip="Collapse" AutomationProperties.Name="Collapse" Cursor="Hand"/>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="11" Background="Transparent"
                            Content="{x:Static t:Glyph.Close}" ToolTip="Close mini-player" AutomationProperties.Name="Close mini-player" Cursor="Hand"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="24" Height="24" Source="{StaticResource LogoImage}" Margin="0,0,8,0"/>
                    <TextBlock Text="Bread Board" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse x:Name="EngineDot" Width="8" Height="8" Fill="{StaticResource MuteBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="Body" Grid.Row="1" Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Transport: step through favourites (or all sounds) and play the selected one -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="{x:Static t:Glyph.Previous}" Background="Transparent"
                        AutomationProperties.Name="Previous sound" ToolTip="Previous sound"/>
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="{x:Static t:Glyph.Play}" Width="64" Height="64" FontSize="24" Margin="20,0"
                        t:Ui.CornerRadius="32" Background="{StaticResource CardBrush}" AutomationProperties.Name="Play" ToolTip="Play"/>
                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="{x:Static t:Glyph.Next}" Background="Transparent"
                        AutomationProperties.Name="Next sound" ToolTip="Next sound"/>
            </StackPanel>

            <!-- Selected sound -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="NowTitle" Text="No sounds yet" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NowDetail" Text="Add sounds in the main window" FontSize="12" Foreground="{StaticResource MuteBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
            <ProgressBar x:Name="NowProgress" Grid.Row="2" Style="{StaticResource Meter}" Maximum="1" Value="0" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}"/>

            <!-- Quick list: favourites or recently played -->
            <DockPanel Grid.Row="3" Margin="0,16,0,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FavTab" Style="{StaticResource Chip}" Content="Favourites" GroupName="minitab" AutomationProperties.Name="Favourites list"/>
                    <RadioButton x:Name="RecentTab" Style="{StaticResource Chip}" Content="Recent" GroupName="minitab" AutomationProperties.Name="Recent list"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <UniformGrid x:Name="Quick" Columns="2"/>
                    <TextBlock x:Name="QuickEmpty" FontSize="12" Foreground="{StaticResource MuteBrush}" TextWrapping="Wrap" Margin="2,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Button x:Name="StopAllButton" Grid.Row="5" Style="{StaticResource SoftButton}" t:Ui.Icon="{x:Static t:Glyph.Stop}" Content="Stop all"
                    Margin="0,16,0,0" HorizontalAlignment="Stretch" ToolTip="Stop every sound that is playing"/>

            <!-- Mic / master mute -->
            <UniformGrid Grid.Row="6" Rows="1" Margin="0,10,0,0">
                <Button x:Name="MicButton" Style="{StaticResource SoftButton}" t:Ui.Icon="{x:Static t:Glyph.MicOff}" Content="Mic" Margin="0,0,6,0"
                        ToolTip="Mute or unmute your microphone" AutomationProperties.Name="Mute microphone"/>
                <Button x:Name="MasterButton" Style="{StaticResource SoftButton}" t:Ui.Icon="{x:Static t:Glyph.Mute}" Content="Master" Margin="6,0,0,0"
                        ToolTip="Mute or unmute everything sent to the virtual mic" AutomationProperties.Name="Mute master output"/>
            </UniformGrid>

            <DockPanel Grid.Row="7" Margin="0,12,0,0">
                <TextBlock Text="Profile" FontSize="12" Foreground="{StaticResource MuteBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                <ComboBox x:Name="ProfileBox" Height="34" FontSize="13" AutomationProperties.Name="Profile"/>
            </DockPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
