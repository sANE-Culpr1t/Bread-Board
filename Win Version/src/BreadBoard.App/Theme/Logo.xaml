<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Bread Board logo: Bread-Board-Logo.png from the project folder, cropped to the artwork and squared
        (Assets/Logo.png, 512 px). Decoded at 256 px: enough for the sidebar, the mini-player and the icon.
    -->
    <BitmapImage x:Key="LogoImage" UriSource="pack://application:,,,/Assets/Logo.png" DecodePixelWidth="256"/>
</ResourceDictionary>
