<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens from the approved web prototype (Web Prototype/README.md). -->
    <Color x:Key="DeskColor">#100F0E</Color>
    <Color x:Key="BaseColor">#181716</Color>
    <Color x:Key="SidebarColor">#1E1D1B</Color>
    <Color x:Key="CardColor">#252422</Color>
    <Color x:Key="RaisedColor">#2D2B29</Color>
    <Color x:Key="HoverColor">#353331</Color>
    <Color x:Key="TrackColor">#3D3B38</Color>
    <Color x:Key="LineColor">#14F4EFE8</Color>
    <Color x:Key="InkColor">#F4EFE8</Color>
    <Color x:Key="MuteColor">#8F8A84</Color>
    <Color x:Key="AccentColor">#E3C8A4</Color>
    <Color x:Key="Accent2Color">#D9A35B</Color>
    <Color x:Key="OnAccentColor">#1C1916</Color>
    <Color x:Key="OkColor">#6FAE7A</Color>
    <Color x:Key="BadColor">#CF6F5F</Color>

    <SolidColorBrush x:Key="DeskBrush" Color="{StaticResource DeskColor}"/>
    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="MuteBrush" Color="{StaticResource MuteColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>

    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusControl">12</CornerRadius>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Sidebar navigation item: pill highlight when checked. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="{StaticResource RadiusControl}" Background="Transparent" Padding="16,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource RaisedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
