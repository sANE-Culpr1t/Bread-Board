<Window x:Class="BreadBoard.App.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:BreadBoard.App.Theme"
        Title="Bread Board — Mini Player"
        MinWidth="270" MinHeight="300"
        Background="{StaticResource SidebarBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: drag to move -->
        <Border x:Name="Header" Grid.Row="0" Padding="14,10,8,10" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Cursor="SizeAll">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Width="30" Height="30" FontSize="13" Background="Transparent"
                                  Content="{x:Static t:Glyph.Pin}" ToolTip="Keep on top" AutomationProperties.Name="Keep on top" Cursor="Hand"/>
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Background="Transparent"
                            Content="&#xE70E;" ToolTip="Collapse" AutomationProperties.Name="Collapse" Cursor="Hand"/>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="11" Background="Transparent"
                            Content="{x:Static t:Glyph.Close}" ToolTip="Close mini-player" AutomationProperties.Name="Close mini-player" Cursor="Hand"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo placeholder (Iteration 6) -->
                    <Border Width="24" Height="24" CornerRadius="6" BorderThickness="1.2" BorderBrush="{StaticResource LineBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Bread Board" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource MuteBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                             ToolTip="Virtual mic: not connected (Iteration 4)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="Body" Grid.Row="1" Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Transport -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Setter Property="ToolTip" Value="Playback controls go live in Iteration 2."/>
                    </Style>
                </StackPanel.Resources>
                <Button Content="{x:Static t:Glyph.Previous}" Background="Transparent" AutomationProperties.Name="Previous sound"/>
                <Button Content="{x:Static t:Glyph.Play}" Width="64" Height="64" FontSize="24" Margin="20,0" t:Ui.CornerRadius="32"
                        Background="{StaticResource CardBrush}" AutomationProperties.Name="Play"/>
                <Button Content="{x:Static t:Glyph.Next}" Background="Transparent" AutomationProperties.Name="Next sound"/>
            </StackPanel>

            <!-- Current sound -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Center">
                <TextBlock Text="Nothing playing" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center"/>
                <TextBlock Text="Your sounds appear here in Iteration 2" FontSize="12" Foreground="{StaticResource MuteBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
            <ProgressBar Grid.Row="2" Style="{StaticResource Meter}" Value="0" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}"/>

            <!-- Mic / master mute -->
            <UniformGrid Grid.Row="3" Rows="1" Margin="0,16,0,0">
                <Button Style="{StaticResource SoftButton}" t:Ui.Icon="{x:Static t:Glyph.MicOff}" Content="Mic" Margin="0,0,6,0" IsEnabled="False"
                        ToolTip="Muting the microphone goes live in Iteration 4." AutomationProperties.Name="Mute microphone"/>
                <Button Style="{StaticResource SoftButton}" t:Ui.Icon="{x:Static t:Glyph.Mute}" Content="Master" Margin="6,0,0,0" IsEnabled="False"
                        ToolTip="Muting the master output goes live in Iteration 4." AutomationProperties.Name="Mute master output"/>
            </UniformGrid>

            <TextBlock Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource MuteBrush}"
                       Text="Drag the header to move · drag an edge to resize"/>
        </Grid>
    </Grid>
</Window>
