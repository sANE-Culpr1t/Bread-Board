<UserControl x:Class="BreadBoard.App.Views.Pages.SoundboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:BreadBoard.App.Theme"
             xmlns:c="clr-namespace:BreadBoard.App.Controls">
    <UserControl.Resources>
        <!-- Category filter chip -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Height="32" CornerRadius="16" Padding="14,0" Background="{StaticResource CardBrush}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#26E3C8A4"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sound pad -->
        <Style x:Key="PadItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Style="{StaticResource Card}" BorderThickness="1.5" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource RaisedBrush}"/>
                                <Setter TargetName="Card" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="-2"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#99E3C8A4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Playing}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Card" Property="Background" Value="#2E2A25"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PadTemplate">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- favourite + shortcut -->
                <TextBlock Grid.Row="0" HorizontalAlignment="Left" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent2Brush}"
                           Text="{x:Static t:Glyph.StarFill}" ToolTip="Favourite">
                    <TextBlock.Visibility>
                        <Binding Path="Favorite" Converter="{StaticResource BoolToVis}"/>
                    </TextBlock.Visibility>
                </TextBlock>
                <Border Grid.Row="0" HorizontalAlignment="Right" CornerRadius="7" Background="{StaticResource RaisedBrush}" Padding="7,2" ToolTip="Shortcut">
                    <TextBlock Text="{Binding Shortcut}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <!-- icon + name -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="34" Foreground="{Binding TintBrush}"/>
                    <TextBlock Text="{Binding Name}" Margin="0,8,0,0" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- duration + status -->
                <DockPanel Grid.Row="2" Margin="0,2,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource MuteBrush}" ToolTip="Duration"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MuteBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ModeGlyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MuteBrush}"/>
                    </StackPanel>
                </DockPanel>
                <!-- progress -->
                <ProgressBar Grid.Row="3" Style="{StaticResource Meter}" Height="4" Margin="0,6,0,0" Maximum="1" Value="{Binding Progress}"
                             Foreground="{StaticResource AccentBrush}" Visibility="{Binding Playing, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" t:Ui.Icon="{x:Static t:Glyph.Add}" Content="Add Sound" IsEnabled="False"
                        ToolTip="Importing WAV, MP3 and OGG files arrives in Iteration 2."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static t:Glyph.Bolt}" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Accent2Brush}" Margin="0,0,12,0"/>
                <TextBlock x:Name="Heading" Text="Quick Access" Style="{StaticResource H1}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource PendingChip}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static t:Glyph.Info}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent2Brush}" Margin="0,0,8,0"/>
                <TextBlock FontSize="12" Foreground="{StaticResource InkBrush}"
                           Text="Sample pads for reviewing the layout. Your own sounds, playback and hotkeys arrive in Iteration 2."/>
            </StackPanel>
        </Border>

        <StackPanel x:Name="Filters" Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,14"/>

        <Grid Grid.Row="3">
            <ListBox x:Name="Pads" ItemTemplate="{StaticResource PadTemplate}" ItemContainerStyle="{StaticResource PadItem}"
                     Background="Transparent" BorderThickness="0" Padding="0,4,4,8" Foreground="{StaticResource InkBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False"
                     AutomationProperties.Name="Sound pads">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><c:AdaptiveGrid MinItemWidth="172" ItemHeight="140" Spacing="16"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <StackPanel x:Name="Empty" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed">
                <TextBlock Text="{x:Static t:Glyph.Search}" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource MuteBrush}"/>
                <TextBlock x:Name="EmptyText" Margin="0,10,0,0" Foreground="{StaticResource MuteBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
